<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzureDevOps.DesktopManager.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False"
             x:Class="AzureDevOps.DesktopManager.Views.Tabs.DashboardTab">
    <StackPanel Spacing="24">
                                <TextBlock Text="Visión General" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                
                                <!-- Cards Row -->
                                <Grid ColumnDefinitions="*, 24, *" Height="140">
                                    <Border Classes="Card" Grid.Column="0">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="🟢" FontSize="16"/>
                                                <TextBlock Text="Estado del Sistema" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                                            </StackPanel>
                                            <TextBlock Text="En Ejecución" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,8,0,0"/>
                                            <TextBlock Text="El worker está sincronizando datos." FontSize="14" Foreground="{DynamicResource SecondaryText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="Card" Grid.Column="2">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="📦" FontSize="16"/>
                                                <TextBlock Text="Proyectos Activos" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Projects.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,8,0,0"/>
                                            <TextBlock Text="Proyectos en el catálogo de BD." FontSize="14" Foreground="{DynamicResource SecondaryText}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Details Card -->
                                <Border Classes="Card">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Información de Depuración" FontSize="18" FontWeight="Bold"/>
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="150, *">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Conexión BD:" Foreground="{DynamicResource SecondaryText}" Margin="0,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IsDbConnected, StringFormat='{}{0}'}" FontWeight="SemiBold" Margin="0,4"/>
                                            
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Identity Name:" Foreground="{DynamicResource SecondaryText}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineUserName, FallbackValue='(Vacio)'}" FontWeight="SemiBold" Margin="0,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Host OS:" Foreground="{DynamicResource SecondaryText}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OSVersion, FallbackValue='(Vacio)'}" FontWeight="SemiBold" Margin="0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
</UserControl>