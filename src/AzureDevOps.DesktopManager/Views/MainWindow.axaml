<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AzureDevOps.DesktopManager.Views.MainWindow"
        xmlns:tabs="using:AzureDevOps.DesktopManager.Views.Tabs"
        x:CompileBindings="False"
        Title="Azure DevOps BI Manager" Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Inter, Segoe UI, sans-serif">

    <Window.Styles>
        <!-- Sidebar Navigation Button Style -->
        <Style Selector="RadioButton.NavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.NavButton:pointerover">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>
        <Style Selector="RadioButton.NavButton:checked">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Card Style -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 4 6 0 #0A000000"/>
        </Style>
        
        <!-- Primary Button -->
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryText}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="#4338CA"/>
        </Style>

        <!-- Secondary Button -->
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryText}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="#E5E7EB"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" /> <!-- Header -->
            <RowDefinition Height="*" />  <!-- Main Area -->
        </Grid.RowDefinitions>

        <!-- ================================= HEADER ================================= -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="24,0">
                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ButtonPrimaryBg}" CornerRadius="8" Width="40" Height="40">
                        <TextBlock Text="AD" Foreground="{DynamicResource ButtonPrimaryText}" FontWeight="Bold" FontSize="18" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Azure DevOps BI" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Ingestion Manager" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Profile Bubble (Windows Identity) -->
                    
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Sync Now Button -->
                    <Button Click="OnForceSyncClick" Background="{DynamicResource ButtonPrimaryBg}" Foreground="{DynamicResource ButtonPrimaryText}" CornerRadius="6" Padding="12,8" Cursor="Hand" ToolTip.Tip="Forzar ciclo de sincronización ahora">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Sincronizar" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Theme Toggle -->
                    <Button Click="OnToggleThemeClick" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8">
                        <TextBlock Text="🌓" FontSize="20" VerticalAlignment="Center"/>
                    </Button>
                    <Button Background="Transparent" BorderThickness="0" CornerRadius="20" Padding="0" HorizontalAlignment="Right" Cursor="Hand">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="16" Width="280">
                                    <TextBlock Text="Identidad de Autenticación" FontWeight="Bold" FontSize="16"/>
                                    <Border Background="{DynamicResource AppBackground}" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Usuario de Windows Actual:" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                            <TextBlock Text="{Binding MachineUserName, FallbackValue='Desconocido'}" FontWeight="SemiBold" FontSize="14"/>
                                            
                                            <Border Height="1" Background="#E5E7EB" Margin="0,4"/>
                                            
                                            <TextBlock Text="Modo de Autenticación TFS:" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                            <TextBlock Text="{Binding UseDefaultCredentials, Converter={x:Static StringConverters.IsNullOrEmpty}, FallbackValue='SSO (Windows Authentication)'}" FontWeight="SemiBold" FontSize="14" IsVisible="{Binding UseDefaultCredentials}"/>
                                            <TextBlock Text="Credenciales Explícitas (NTLM)" FontWeight="SemiBold" FontSize="14" IsVisible="{Binding !UseDefaultCredentials}"/>
                                            
                                            <StackPanel IsVisible="{Binding !UseDefaultCredentials}" Margin="0,8,0,0" Spacing="4">
                                                <TextBlock Text="Dominio configurado:" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                                <TextBlock Text="{Binding AuthDomain, FallbackValue='(Ninguno)'}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="Usuario configurado:" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                                                <TextBlock Text="{Binding AuthUsername, FallbackValue='(Ninguno)'}" FontWeight="SemiBold" FontSize="13"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Nota: Si el servidor TFS responde con error 401 (Unauthorized), intente desmarcar 'SSO' en la Configuración e ingrese sus credenciales explícitas de red." 
                                               TextWrapping="Wrap" FontSize="12" Foreground="#D97706" FontStyle="Italic"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <Border Background="{DynamicResource AppBackground}" CornerRadius="20" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MachineUserName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="▼" FontSize="10" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                            </StackPanel>
            </Grid>
        </Border>

        <!-- ================================= BODY ================================= -->
        <Grid Grid.Row="1" ColumnDefinitions="250, *">
            
            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16">
                    <TextBlock Text="MENÚ PRINCIPAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="24,8,24,8" />
                    
                    <RadioButton Classes="NavButton" IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                                 Click="OnNavTabClick" CommandParameter="0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📊" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Classes="NavButton" IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}"
                                 Click="OnNavTabClick" CommandParameter="1">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📂" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Catálogo de Proyectos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="NavButton" IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}"
                                 Click="OnNavTabClick" CommandParameter="2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="⚙️" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Configuración TFS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Classes="NavButton" IsChecked="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}"
                                 Click="OnNavTabClick" CommandParameter="3">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📝" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Live Logs &amp; Debug" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Margin="32">
                <ContentControl>
                    <!-- Instead of full ContentControl binding, we can use a Carousel or Grid with IsVisible based on CurrentTab -->
                    <Grid>
                                                <!-- TAB 0: DASHBOARD -->
                        <Grid IsVisible="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                            <tabs:DashboardTab />
                        </Grid>

                        <!-- TAB 1: CATALOGO -->
                        <Grid IsVisible="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
                            <tabs:MappingTab />
                        </Grid>

                        <!-- TAB 2: CONFIGURACION -->
                        <Grid IsVisible="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}">
                            <tabs:ConfigTab />
                        </Grid>

                        <!-- TAB 3: LOGS -->
                        <Grid IsVisible="{Binding CurrentTab, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}">
                            <tabs:LogsTab />
                        </Grid>
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- ================================= NOTIFICATION OVERLAY ================================= -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                IsVisible="{Binding IsNotificationVisible}"
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="32,90,32,0" 
                Background="{DynamicResource CardBackground}" 
                CornerRadius="8" 
                Padding="16" 
                BoxShadow="0 10 15 -3 #1A000000, 0 4 6 -2 #0D000000"
                BorderBrush="{Binding IsNotificationError, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, FallbackValue='#E5E7EB'}"
                BorderThickness="1,1,1,4">
            
            <StackPanel Orientation="Horizontal" Spacing="16" MaxWidth="350">
                <TextBlock Text="❌" 
                           IsVisible="{Binding IsNotificationError}"
                           FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Text="✅" 
                           IsVisible="{Binding !IsNotificationError}"
                           FontSize="24" VerticalAlignment="Center"/>
                           
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding NotificationTitle}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="{Binding NotificationMessage}" FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- NON-BLOCKING LOADING INDICATOR (Top Right) -->
        <Border Grid.Row="0" Grid.RowSpan="2" 
                IsVisible="{Binding IsBusy}"
                IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" 
                Margin="0,16,0,0" 
                Background="{DynamicResource CardBackground}" 
                CornerRadius="16" 
                Padding="16,8" 
                BoxShadow="0 4 6 0 #1A000000">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="⏳" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#4F46E5" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
