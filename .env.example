# ==============================================================================
# AZURE DEVOPS BI - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# --- BASE DE DATOS (POSTGRESQL & DOCKER) ---
POSTGRES_DB=azure_devops_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123!
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Cadena de conexión para Worker (.NET) y Motor OLAP (DuckDB / Python)
# Cuando se ejecuta fuera del contenedor (host): localhost
# Cuando se ejecuta dentro de red docker: postgres
DB_HOST=localhost
DB_PORT=5432
ConnectionStrings__PostgresDb="Host=localhost;Port=5432;Database=azure_devops_dw;Username=postgres;Password=postgres_secure_password_123!;Include Error Detail=true;"

# --- AZURE DEVOPS SERVER (TFS 2019 ON-PREMISE) ---
# URL Base del servidor TFS 2019 On-Premise
AzureDevOps__BaseUrl=http://edvwp-tfs19-ap/
AzureDevOps__Collection=DefaultCollection
AzureDevOps__Project=
AzureDevOps__ApiVersion=5.0-preview
AzureDevOps__BatchSize=200
AzureDevOps__PollIntervalSeconds=300
AzureDevOps__MaxRetryAttempts=4
AzureDevOps__RetryBaseDelaySeconds=2

# Autenticación Integrada de Windows (NTLM / SSPI / SSO)
# Si corre bajo la identidad del dominio (Worker en Windows / Service Account): UseDefaultCredentials=true
# Si corre desde Linux/Contenedor hacia TFS NTLM: configurar Domain, Username, Password
AzureDevOps__Auth__UseDefaultCredentials=true
AzureDevOps__Auth__Domain=
AzureDevOps__Auth__Username=
AzureDevOps__Auth__Password=

# --- MOTOR DE TRANSFORMACIÓN (PYTHON & DUCKDB) ---
Transformation__Enabled=true
Transformation__PythonExecutable=uv
Transformation__ScriptPath=./analytics_engine/transform_analytics.py
Transformation__TimeoutSeconds=300

# --- POWER BI WEB REST API (SERVICE PRINCIPAL REFRESH) ---
PowerBi__Enabled=false
PowerBi__TenantId=00000000-0000-0000-0000-000000000000
PowerBi__ClientId=00000000-0000-0000-0000-000000000000
PowerBi__ClientSecret=YOUR_AZURE_AD_APP_CLIENT_SECRET
PowerBi__WorkspaceId=00000000-0000-0000-0000-000000000000
PowerBi__DatasetId=00000000-0000-0000-0000-000000000000
